# MindEase AI - Environment Configuration
# Copy this file to `.env` and fill in your real values. Never commit `.env`.

# ---------- Database ----------
# Async URL used by the FastAPI application. For local dev with SQLite use:
#   DATABASE_URL=sqlite+aiosqlite:///./mindease_dev.db
# For Postgres use the asyncpg scheme: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./mindease_dev.db
# Sync URL used by the seed script (psycopg2)
SYNC_DATABASE_URL=sqlite:///./mindease_dev.db

# ---------- Security ----------
# Generate a strong secret:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Encryption key used for sensitive at-rest data
ENCRYPTION_KEY=change-me-to-another-random-secret

# ---------- AI Provider ----------
# Options: mock | openai | huggingface
# "mock" is the safe local demo fallback that runs without any API key.
AI_PROVIDER=mock
# Only needed if AI_PROVIDER is openai or huggingface
AI_API_KEY=

# ---------- Redis (optional) ----------
REDIS_URL=redis://localhost:6379/0

# ---------- CORS ----------
# Comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# ---------- Database Schema ----------
# When true, tables are created from SQLAlchemy models on app startup
CREATE_TABLES_ON_STARTUP=true

# ---------- Demo seed credentials (override in production) ----------
# Used by `python -m seed_data` to create the demo accounts.
# These defaults exist ONLY so a fresh demo environment is usable out of the box.
# In production, set these to strong random values BEFORE seeding.
DEMO_USER_PASSWORD=change-me-demo-user
DEMO_COUNSELOR_PASSWORD=change-me-demo-counselor
DEMO_ADMIN_PASSWORD=change-me-demo-admin