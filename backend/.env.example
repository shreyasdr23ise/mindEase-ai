# ─── MindEase AI — Environment Configuration ─────────────────────────────
# Copy this file to `.env` and fill in your real values. Never commit `.env`.

# ─── Database ──────────────────────────────────────────────────────────────
# Async URL used by the FastAPI application
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mindease_ai
# Sync URL used by the seed script (psycopg2)
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mindease_ai

# ─── Security ──────────────────────────────────────────────────────────────
# Generate a strong secret:  `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=change-me-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Encryption key used for any sensitive at-rest data (not currently required for demo)
ENCRYPTION_KEY=change-me-to-another-random-secret

# ─── AI Provider ───────────────────────────────────────────────────────────
# Options: mock | openai | huggingface
# "mock" is the safe local demo fallback that runs without any API key.
AI_PROVIDER=mock
# Your API key (only needed if AI_PROVIDER is openai or huggingface)
AI_API_KEY=

# ─── Redis (optional) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# ─── Database Schema ───────────────────────────────────────────────────────
# When true, tables are created from SQLAlchemy models on app startup
CREATE_TABLES_ON_STARTUP=true